# Скопируй в .env и поправь под себя: cp .env.example .env
#
# Ни одно значение отсюда не должно попасть в git. .env в .gitignore.
# На этапе 8 (k8s/Terraform) эти же ключи поедут в Secret / SOPS / Vault —
# приложение не знает, откуда пришло значение, оно просто читает окружение.

ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Должен совпадать с настройками Postgres в deploy/compose/docker-compose.dev.yml
DATABASE_URL=postgresql+psycopg://finance:finance@localhost:5433/finance

# Обязательно смени на длинную случайную строку: openssl rand -hex 32
JWT_SECRET=dev-only-secret-change-me
JWT_EXPIRE_MINUTES=10080

DEFAULT_CURRENCY=RUB
